# .env.production.example — ШАБЛОН для production-деплоя
#
# === ПОРЯДОК НАСТРОЙКИ ===
# 1. В WSL2/терминале проекта: bash scripts/prepare-production-env.sh
#    Скрипт создаёт оба env-файла, генерирует случайные секреты и JWT-ключи,
#    не перезаписывая уже заполненные значения.
# 2. Заполните реальные внешние credentials (SMTP, VAPID, Yandex/VK, YooKassa, Telegram).
# 3. Проверьте готовность: bash scripts/deploy-single-container.sh --config
# 4. После прохождения gate запуск: bash scripts/deploy-single-container.sh --up
#
# Файл .env.production НЕ коммитить в git! Уже в .gitignore.

# ===== DATABASE (PRODUCTION) =====
# Единый PG17 runtime: production overlay переопределяет DATABASE_URL и DIRECT_DATABASE_URL,
# используя APP_DATABASE_PASSWORD из .env.supabase-runtime. Не подключать отдельный db/PG15/PG18.
DATABASE_URL=postgresql://conditera_app:OVERLAY_MANAGED@supabase-runtime:5432/supabase?schema=public
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ⚠️  USER-MUST-FILL — URL вашего Kong (self-hosted) или https://PROJECT_ID.supabase.co (cloud)
NEXT_PUBLIC_SUPABASE_URL=https://conditera.ru/api
API_EXTERNAL_URL=https://conditera.ru/api
SUPABASE_PUBLIC_URL=https://conditera.ru/api
SITE_URL=https://conditera.ru
# Необязательно: внутренний адрес Kong, если Supabase runtime подключён к сети conditera-net.
# Внешний браузерный URL остаётся NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_INTERNAL_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_REAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_REAL_SERVICE_ROLE_KEY

# ===== APP =====
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Уездный кондитер
NEXT_PUBLIC_APP_DESCRIPTION=Маркетплейс кондитерских изделий
NEXT_PUBLIC_APP_URL=https://conditera.ru
# Версии юридических документов фиксируются в журнале согласий.
LEGAL_PRIVACY_VERSION=2026-11-18.1
LEGAL_TERMS_VERSION=2026-11-18.1
LEGAL_OFFER_VERSION=2026-11-18.1
LEGAL_MARKETING_VERSION=2026-11-18.1

# ===== REDIS =====
REDIS_URL=redis://redis:6379

# ===== MEILISEARCH =====
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_STRONG_MEILI_KEY_32_CHARS

# ===== SMTP (PRODUCTION) =====
# ⚠️  USER-MUST-FILL — реальный SMTP (mail.conditera.ru, smtp.yandex.ru, smtp.mailgun.org)
SMTP_HOST=mail.conditera.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_FROM=noreply@conditera.ru
SMTP_USER=
SMTP_PASSWORD=
SMTP_REPLY_TO=support@conditera.ru

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== n8n =====
N8N_BASE_URL=http://n8n:5678
# Leave empty until the matching authenticated n8n event-bus workflow is imported and activated.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_ADMIN_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_32
N8N_API_KEY=CHANGE_ME_N8N_API_KEY_32_CHARS

# ===== AUTH / SECURITY (PRODUCTION — сгенерируйте случайные) =====
# ⚠️  USER-MUST-FILL — сгенерируйте 32-символьные случайные строки:
#   openssl rand -hex 32
ENCRYPTOR_KEY=CHANGE_ME_USE_openssl_rand_hex_32
SECRET_KEY_BASE=CHANGE_ME_USE_openssl_rand_hex_32
SIMPLEX_BRIDGE_API_KEY=CHANGE_ME_USE_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
# ⚠️ Отдельный секрет для refresh-токенов (НЕ копия JWT_SECRET):
JWT_REFRESH_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
TFA_ENCRYPTION_KEY=CHANGE_ME_USE_openssl_rand_hex_32
IP_HASH_SALT=CHANGE_ME_16CHARS
CRON_SECRET=CHANGE_ME_24CHARS
BOT_SECRET=CHANGE_ME_24CHARS
# ⚠️ Telegram webhook: secret token из setWebhook (проверяется в X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_24CHARS

# ⚠️ Входящие письма (webhook /api/email/inbound): в production подпись ОБЯЗАТЕЛЬНА,
# без хотя бы одного ключа endpoint отвечает 503
MAILGUN_SIGNING_KEY=
SENDGRID_WEBHOOK_KEY=

# ===== SUPABASE STORAGE =====
# Если Supabase Storage на отдельном домене (CDN):
SUPABASE_STORAGE_HOSTNAME=cdn.conditera.ru
SUPABASE_STORAGE_PROTOCOL=https
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_COVERS=covers
STORAGE_BUCKET_PORTFOLIO=portfolio
STORAGE_BUCKET_PRODUCT_IMAGES=product_images
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_MESSAGES=messages
UPLOAD_MAX_AVATAR_SIZE=5242880
UPLOAD_MAX_PORTFOLIO_SIZE=10485760
UPLOAD_MAX_PRODUCT_IMAGE_SIZE=10485760

# ===== YANDEX METRIKA (PRODUCTION) =====
# ⚠️  USER-MUST-FILL — ID счётчика Яндекс.Метрики проекта «Уездный кондитер»: 111432662
NEXT_PUBLIC_YANDEX_METRIKA_ID=111432662

# ⚠️  USER-MUST-FILL — OAuth-токен для server-side tracking (офлайн-конверсии)
# Получить: https://oauth.yandex.ru/ → выдать права metrica:write
YANDEX_METRIKA_OAUTH_TOKEN=

# ⚠️  USER-MUST-FILL — API-ключ Яндекс.Геокодера (для geocoder.ts)
# https://developer.tech.yandex.ru/services/
YANDEX_GEOCODER_API_KEY=

# ===== OAUTH (PRODUCTION — реальные redirect URI на https://conditera.ru) =====
# GoTrue runtime provider toggles. Keep false until credentials and callback URLs are verified.
EXTERNAL_YANDEX_ENABLED=false # Keep false: Conditera handles Yandex PKCE callback in /api/auth/oauth/yandex/callback
EXTERNAL_GOOGLE_ENABLED=false
EXTERNAL_VK_ENABLED=false # Keep false: Conditera handles VK ID PKCE callback in /api/auth/oauth/vk/callback

# ⚠️  USER-MUST-FILL — Yandex OAuth
# https://oauth.yandex.ru/client/new
# Redirect URI: https://conditera.ru/api/auth/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/yandex/callback

# ⚠️  USER-MUST-FILL — Google OAuth (OAuth 2.0 Web application)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/google/callback

# ⚠️  USER-MUST-FILL — VK ID (не старый VK OAuth)
# Создать Web-приложение VK ID и зарегистрировать точный Redirect URL.
# Серверный адаптер использует Authorization Code Flow с PKCE и id.vk.ru.
VK_CLIENT_ID=
VK_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/vk/callback

# ⚠️  USER-MUST-FILL — Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/telegram/callback

# ===== YOOKASSA (PRODUCTION — реальные ключи, начинаются с live_) =====
# ⚠️  USER-MUST-FILL — https://yookassa.ru/my-account/settings
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ===== AI / LLM =====
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b
LLM_API_BASE=http://llm:11434/v1
LLM_API_KEY=

# ===== LOGGING =====
LOG_LEVEL=info
