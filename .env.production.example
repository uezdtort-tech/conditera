# .env.production.example — ШАБЛОН для production-деплоя
#
# === ПОРЯДОК НАСТРОЙКИ ===
# 1. На сервере:  cp .env.production.example .env.production
# 2. ИЛИ запустите:  bash scripts/setup-env.sh prod
# 3. Заполните ВСЕ секции помеченные ⚠️ USER-MUST-FILL
# 4. Проверьте готовность:  bash scripts/env-check.sh production
#
# Файл .env.production НЕ коммитить в git! Уже в .gitignore.

# ===== DATABASE (PRODUCTION) =====
# ⚠️  USER-MUST-FILL — реальный URL вашей production PostgreSQL (Supabase)
# Пример self-hosted Supabase: postgresql://postgres:STRONG_PASSWORD@db:5432/postgres
# Пример Supabase Cloud: postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@db:5432/postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ⚠️  USER-MUST-FILL — URL вашего Kong (self-hosted) или https://PROJECT_ID.supabase.co (cloud)
NEXT_PUBLIC_SUPABASE_URL=https://conditera.ru/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_REAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_REAL_SERVICE_ROLE_KEY

# ===== APP =====
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Уездный кондитер
NEXT_PUBLIC_APP_DESCRIPTION=Маркетплейс кондитерских изделий
NEXT_PUBLIC_APP_URL=https://conditera.ru

# ===== REDIS =====
REDIS_URL=redis://redis:6379

# ===== MEILISEARCH =====
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_STRONG_MEILI_KEY_32_CHARS

# ===== SMTP (PRODUCTION) =====
# ⚠️  USER-MUST-FILL — реальный SMTP (mail.conditera.ru, smtp.yandex.ru, smtp.mailgun.org)
SMTP_HOST=mail.conditera.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=noreply@conditera.ru
SMTP_REPLY_TO=support@conditera.ru

# ===== n8n =====
N8N_WEBHOOK_URL=https://n8n.conditera.ru
N8N_API_KEY=CHANGE_ME_N8N_API_KEY_32_CHARS

# ===== AUTH / SECURITY (PRODUCTION — сгенерируйте случайные) =====
# ⚠️  USER-MUST-FILL — сгенерируйте 32-символьные случайные строки:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
TFA_ENCRYPTION_KEY=CHANGE_ME_USE_openssl_rand_hex_32
IP_HASH_SALT=CHANGE_ME_16CHARS
CRON_SECRET=CHANGE_ME_24CHARS
BOT_SECRET=CHANGE_ME_24CHARS

# ===== SUPABASE STORAGE =====
# Если Supabase Storage на отдельном домене (CDN):
SUPABASE_STORAGE_HOSTNAME=cdn.conditera.ru
SUPABASE_STORAGE_PROTOCOL=https
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_COVERS=covers
STORAGE_BUCKET_PORTFOLIO=portfolio
STORAGE_BUCKET_PRODUCT_IMAGES=product_images
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_MESSAGES=messages
UPLOAD_MAX_AVATAR_SIZE=5242880
UPLOAD_MAX_PORTFOLIO_SIZE=10485760
UPLOAD_MAX_PRODUCT_IMAGE_SIZE=10485760

# ===== YANDEX METRIKA (PRODUCTION) =====
# ⚠️  USER-MUST-FILL — ID счётчика Яндекс.Метрики проекта «Уездный кондитер»: 111432662
NEXT_PUBLIC_YANDEX_METRIKA_ID=111432662

# ⚠️  USER-MUST-FILL — OAuth-токен для server-side tracking (офлайн-конверсии)
# Получить: https://oauth.yandex.ru/ → выдать права metrica:write
YANDEX_METRIKA_OAUTH_TOKEN=

# ⚠️  USER-MUST-FILL — API-ключ Яндекс.Геокодера (для geocoder.ts)
# https://developer.tech.yandex.ru/services/
YANDEX_GEOCODER_API_KEY=

# ===== OAUTH (PRODUCTION — реальные redirect URI на https://conditera.ru) =====
# ⚠️  USER-MUST-FILL — Yandex OAuth
# https://oauth.yandex.ru/client/new
# Redirect URI: https://conditera.ru/api/auth/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/yandex/callback

# ⚠️  USER-MUST-FILL — Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/google/callback

# ⚠️  USER-MUST-FILL — VK OAuth
# https://dev.vk.com/
VK_CLIENT_ID=
VK_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/vk/callback

# ⚠️  USER-MUST-FILL — Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_OAUTH_REDIRECT=https://conditera.ru/api/auth/oauth/telegram/callback

# ===== YOOKASSA (PRODUCTION — реальные ключи, начинаются с live_) =====
# ⚠️  USER-MUST-FILL — https://yookassa.ru/my-account/settings
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ===== AI / LLM =====
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b
LLM_API_BASE=http://llm:11434/v1
LLM_API_KEY=
N8N_AI_WEBHOOK_URL=https://n8n.conditera.ru

# ===== LOGGING =====
LOG_LEVEL=info
