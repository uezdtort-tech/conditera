# ====================================================================
# Dockerfile для chat-service (Socket.IO) — «Уездный кондитер»
# ====================================================================
# Исходники: mini-services/chat-server/ (index.ts + package.json)
# Runtime: bun (быстрее node для TypeScript без компиляции)
# Порт: 3030
# Healthcheck: GET /health → 200 OK
#
# Запуск в docker-compose.yml:
#   chat-service:
#     build:
#       context: .
#       dockerfile: Dockerfile.chat
# ====================================================================

# v3 (registry-hardening): oven/bun публичных зеркал не имеет, а Docker Hub ловит
# 429 в GH Actions — берём node из public.ecr.aws и ставим bun CLI из npm
# (musl-бинарь @oven/bun-linux-x64-musl; в runtime работает так же, как oven/bun).
FROM public.ecr.aws/docker/library/node:20-alpine
WORKDIR /app

# dumb-init для корректной обработки сигналов (SIGTERM, SIGINT) + bun CLI из npm
RUN apk add --no-cache dumb-init wget && npm install -g bun@1

# Копируем lockfile ДО установки — иначе --frozen-lockfile падает (нет lockfile)
# и срабатывает недетерминированный fallback
COPY mini-services/chat-server/package.json ./
COPY mini-services/chat-server/bun.lock* ./
RUN bun install --production --frozen-lockfile

# Копируем исходники
COPY mini-services/chat-server/index.ts ./

# Создаём непривилегированного пользователя
RUN addgroup -S chat && adduser -S chat -G chat
RUN chown -R chat:chat /app
USER chat

EXPOSE 3030

# Healthcheck: проверяем что chat-server отвечает на /health
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:3030/health > /dev/null 2>&1 || exit 1

# Запускаем через dumb-init для корректной обработки сигналов
CMD ["dumb-init", "bun", "run", "index.ts"]
