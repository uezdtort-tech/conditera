# Отдельные секреты единого Supabase runtime.
# Хранить в .env.supabase-runtime (файл игнорируется Git).
# Загружать только для Compose runtime overlay:
#   docker compose --env-file .env.production --env-file .env.supabase-runtime ...
#
# Генерация:
# APP_DATABASE_PASSWORD: openssl rand -hex 32
# BACKUP_DATABASE_PASSWORD: openssl rand -hex 32
# SUPABASE_SECRET_KEY_BASE: openssl rand -hex 32
# PG_META_CRYPTO_KEY: openssl rand -hex 16
# REALTIME_DB_ENC_KEY: openssl rand -hex 8 (ровно 16 hex characters)
# REALTIME_DB_ENC_KEY_GCM: openssl rand -hex 16 (ровно 32 hex characters)

APP_DATABASE_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_32
SUPABASE_SECRET_KEY_BASE=CHANGE_ME_USE_openssl_rand_hex_32
PG_META_CRYPTO_KEY=CHANGE_ME_USE_openssl_rand_hex_16
REALTIME_DB_ENC_KEY=CHANGE_ME_USE_openssl_rand_hex_8
REALTIME_DB_ENC_KEY_GCM=CHANGE_ME_USE_openssl_rand_hex_16
