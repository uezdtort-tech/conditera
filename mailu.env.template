# ====================================================================
# mailu.env — Конфигурация Mailu почтового сервера
# ====================================================================
# Этот файл загружается docker-compose при запуске сервиса mailu.
# НЕ КОММИТИТЬ с реальными паролями!
#
# Сгенерировать SECRET_KEY:
#   openssl rand -hex 32
# ====================================================================

# Секретный ключ для шифрования (обязательно сменить!)
SECRET_KEY=CHANGE_ME_MAILU_SECRET_KEY_64_HEX_CHARS

# Домен
DOMAIN=conditera.ru
HOSTNAMES=mail.conditera.ru
POSTMASTER=admin@conditera.ru

# Подсеть для контейнеров Mailu (внутренняя)
SUBNET=192.168.203.0/24

# Настройки отправки
RELAYNETS=
RELAYHOST=

# Антиспам/антивирус (true/false)
DISABLE_ANTIVIRUS=true   # ClamAV тяжёлый — отключить на серверах < 4 ГБ RAM
DISABLE_SPAM_FILTER=false

# Webmail
WEBMAIL=roundcube
WEBROOT_REDIRECT=/webmail

# Управление (admin panel)
ADMIN=true
WEB_ADMIN=/admin

# Лимиты
MESSAGE_SIZE_LIMIT=52428800  # 50 МБ максимальный размер письма
AUTH_RATELIMIT=10/minute     # лимит попыток авторизации

# База данных (встроенный SQLite, для продакшна можно PostgreSQL)
DB_FLAVOR=sqlite
DB_HOST=
DB_PORT=
DB_USER=
DB_PW=
DB_NAME=

# TLS (Let's Encrypt автоматически)
TLS_FLAVOR=letsencrypt
CERTS_PATH=/certs

# Время жизни сессии (часы)
SESSION_TIMEOUT=60

# Логирование
LOG_LEVEL=WARNING
