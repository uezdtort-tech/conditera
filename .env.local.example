# .env.local.example — шаблон для локальной разработки
#
# === ПОРЯДОК НАСТРОЙКИ ===
# 1. Скопируйте в .env.local:  cp .env.local.example .env.local
# 2. ИЛИ запустите интерактивный мастер:  bash scripts/setup-env.sh dev
# 3. Заполните все секции помеченные как  ⚠️  USER-MUST-FILL  (это реальные секреты/ID, без них функции не работают)
# 4. Проверьте готовность:  bash scripts/env-check.sh
#
# Секция DATABASE имеет 3 варианта — выберите один и раскомментируйте.

# ===== DATABASE =====
# ВАРИАНТ A: Docker Supabase (рекомендуется для dev, порт 54322):
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.UDfRkk0IVjJWLn1JT6o4vl9Aw1k2jEr3M7tDwP4mPhA
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.UDfRkk0IVjJWLn1JT6o4vl9Aw1k2jEr3M7tDwP4mPhA
#
# ВАРИАНТ B: Docker dev (docker-compose.dev.yml, PostgreSQL на порту 5433):
#   DATABASE_URL=postgresql://uyezdny:uyezdny_dev_pass@localhost:5433/uyezdny_konditer_dev?schema=public
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=

# ===== APP =====
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Уездный кондитер
NEXT_PUBLIC_APP_DESCRIPTION=Маркетплейс кондитерских изделий
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== REDIS (Docker dev, порт 6380) =====
REDIS_URL=redis://localhost:6380

# ===== MEILISEARCH (Docker dev, порт 7700) =====
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev_meili_key_32_chars_min_aaaaaa

# ===== SMTP (Mailpit в Docker dev) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=dev@conditera.ru
SMTP_REPLY_TO=dev@conditera.ru

# ===== n8n (Docker dev, порт 5678) =====
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=dev_n8n_api_key_32_chars_aaaaaa

# ===== AUTH / SECURITY (DEV defaults — НЕ для production) =====
JWT_SECRET=dev_jwt_secret_change_me_in_production_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
TFA_ENCRYPTION_KEY=dev_tfa_encryption_key_32_chars_change_me
IP_HASH_SALT=dev_ip_hash_salt_16char
CRON_SECRET=dev_cron_secret_change_me_24chars
BOT_SECRET=dev_bot_secret_change_me_24chars

# ===== SUPABASE STORAGE (бакеты создаются migration 0026) =====
# Опционально: при self-hosted prod с собственным доменом для Supabase Storage.
# Если не задано — используется стандартный **.supabase.co паттерн в next.config.ts.
# SUPABASE_STORAGE_HOSTNAME=cdn.conditera.ru
# SUPABASE_STORAGE_PROTOCOL=https
# Имена бакетов (по умолчанию создаются migration 0026, можно переопределить только в крайнем случае):
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_COVERS=covers
STORAGE_BUCKET_PORTFOLIO=portfolio
STORAGE_BUCKET_PRODUCT_IMAGES=product_images
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_MESSAGES=messages
# Лимиты загрузки (байты)
UPLOAD_MAX_AVATAR_SIZE=5242880
UPLOAD_MAX_PORTFOLIO_SIZE=10485760
UPLOAD_MAX_PRODUCT_IMAGE_SIZE=10485760

# =========================================================================
# ===== YANDEX METRIKA (Аналитика) =====
# =========================================================================
# ⚠️  USER-MUST-FILL — это ID счётчика, который уже зарегистрирован в Яндекс.Метрике
# ID счётчика проекта «Уездный кондитер»: 111432662
# Получить/проверить: https://metrica.yandex.ru/list
NEXT_PUBLIC_YANDEX_METRIKA_ID=111432662

# ⚠️  USER-MUST-FILL — OAuth-токен для server-side tracking (отправка офлайн-конверсий)
# Получить: https://oauth.yandex.ru/ → "Перейти к приложению" → выдать права на metrica:write
# Без него клиентский трекинг (trackEvent, hit) работает, server-side — нет.
YANDEX_METRIKA_OAUTH_TOKEN=

# ⚠️  USER-MUST-FILL — API-ключ Яндекс.Геокодера (используется в src/lib/geocoder.ts)
# Получить: https://developer.tech.yandex.ru/services/ → "Геокодер" → получить ключ
# Лимит free-tier: 25 000 запросов/сутки. Если пусто — geocoder fallback на DaData/словари городов.
YANDEX_GEOCODER_API_KEY=

# =========================================================================
# ===== OAUTH ПРОВАЙДЕРЫ =====
# =========================================================================
# Все OAuth-провайдеры: при незаполненных полях или значениях `stub_*` маршрут
# /api/auth/oauth/[provider] возвращает 501 stub — кнопки в auth-modal отображаются,
# но реальный редирект не происходит.
#
# Если вы хотите включить конкретный провайдер — заполните пару CLIENT_ID + OAUTH_REDIRECT.

# ----- YANDEX OAuth -----
# ⚠️  USER-MUST-FILL — для кнопки "Войти через Яндекс" в auth-modal
# Создать приложение: https://oauth.yandex.ru/client/new
# В настройках приложения:
#   - Платформы → Веб-сервисы → Redirect URI: http://localhost:3000/api/auth/oauth/yandex/callback (dev)
#                                              https://conditera.ru/api/auth/oauth/yandex/callback (prod)
#   - Доступ к данным: login:email, login:info
#   - Подтвердить телефон по SMS
YANDEX_CLIENT_ID=
YANDEX_OAUTH_REDIRECT=http://localhost:3000/api/auth/oauth/yandex/callback

# ----- GOOGLE OAuth -----
# ⚠️  USER-MUST-FILL — для кнопки "Войти через Google" в auth-modal
# Создать: https://console.cloud.google.com/apis/credentials → "Create credentials" → OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT=http://localhost:3000/api/auth/oauth/google/callback

# ----- VK OAuth -----
# ⚠️  USER-MUST-FILL — для кнопки "Войти через VK" в auth-modal
# Создать: https://dev.vk.com/ → "Мои приложения" → создать
# Redirect URI: http://localhost:3000/api/auth/oauth/vk/callback
VK_CLIENT_ID=
VK_OAUTH_REDIRECT=http://localhost:3000/api/auth/oauth/vk/callback

# ----- TELEGRAM -----
# ⚠️  USER-MUST-FILL — для Telegram-бота и Telegram Login Widget
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_OAUTH_REDIRECT=http://localhost:3000/api/auth/oauth/telegram/callback

# ===== YOOKASSA (dev test mode) =====
# ⚠️  USER-MUST-FILL — для приёма платежей. dev-ключи от https://yookassa.ru/my-account/settings
# В dev-режиме используйте test-ключи (начинаются с `test_`)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ===== AI / LLM (Ollama / LM Studio / n8n) =====
# Провайдер: ollama | lmstudio | n8n | none (none = rule-based fallback)
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
N8N_AI_WEBHOOK_URL=

# ===== LOGGING =====
LOG_LEVEL=debug
