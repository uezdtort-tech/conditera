# ===== Caddyfile — обратный прокси с авто-HTTPS для conditera.ru =====
# Документация: https://caddyserver.com/docs/caddyfile
#
# ВАЖНО для Cloudflare Tunnel 502:
# Если web:3000 недоступен (контейнер не запущен или ещё стартует),
# Caddy возвращает 502 Bad Gateway. Чтобы этого избежать:
#   1. health_check опрашивает /api/health каждые 10с — Caddy не отправляет
#      трафик на нездоровый upstream (вместо 502 возвращает 503 с понятной ошибкой).
#   2. fallback на статичную "service unavailable" страницу если web совсем мёртв.
#   3. Для Cloudflare Tunnel: tunnel → http://localhost:80 (Caddy),
#      НЕ напрямую к web:3000 — иначе при рестарте Next.js будет 502.

# Основной домен + www-редирект
conditera.ru, www.conditera.ru {
        # Редирект www → корень (если зашли на www.conditera.ru)
        # (Caddy автоматически делает это через 'www.conditera.ru' в сертификате)

        # ===== Доверенный прокси: X-Real-IP (v4.6, P0-antifraud) =====
        # Приложение (extractIp/getClientIP) доверяет ТОЛЬКО перезаписанному
        # proxy-значению X-Real-IP. Без header_up клиентский (подделанный)
        # X-Real-IP прошёл бы сквозь Caddy нетронутым → обход per-IP rate-limit.
        #
        # Фактическая цепочка ingress — ДВЕ топологии (обе поддержаны ниже):
        #   A) Прямой доступ: клиент → Caddy :80/:443. Пир Caddy = КЛИЕНТ.
        #   B) Cloudflare Tunnel: клиент → CF edge (edge ПЕРЕЗАПИСЫВАЕТ
        #      CF-Connecting-IP, подделать нельзя) → cloudflared (outbound
        #      к CF, приём только из туннеля) → http://localhost:80 → Caddy.
        #      Пир Caddy = ЛОКАЛЬНЫЙ cloudflared (127.0.0.1/::1) — НЕ клиент!
        #      Брать {remote_host} в топологии B нельзя: все клиенты схлопнутся
        #      в один бакет 127.0.0.1 (3 регистрации/час НА ВЕСЬ САЙТ).
        #
        # Решение — условная перезапись по peer (матчер @loopback_peer):
        #   • peer из loopback (tunnel) → X-Real-IP := CF-Connecting-IP
        #     (установлен CF edge, через туннельный путь не подделывается);
        #   • иначе (прямой клиент) → X-Real-IP := {remote_host} (реальный TCP-
        #     адрес пира), а клиентский CF-Connecting-IP УДАЛЯЕТСЯ (подделка
        #     невозможна по построению: X-Real-IP всегда перезаписан, и приложение
        #     проверяет x-real-ip ДО cf-connecting-ip).
        # Требование целостности пути B: cloudflared принимает запросы ТОЛЬКО
        # из туннеля Cloudflare (собственный протокол, outbound-соединения) —
        # прямая инъекция в cloudflared извне отсутствует.
        # См. docs/DNS_SETUP.md, раздел «Доверенный прокси».
        @loopback_peer {
                remote_ip 127.0.0.1 ::1
        }

        # ===== Маршрутизация Supabase и API приложения =====
        # NEXT_PUBLIC_SUPABASE_URL=https://conditera.ru/api.
        # Supabase JS обращается к /api/auth/v1, /api/rest/v1,
        # /api/realtime/v1 и /api/storage/v1. Снимаем префикс /api
        # и передаём запросы в Kong.
        @supabase_auth path /api/auth/v1/*
        handle @supabase_auth {
                uri strip_prefix /api
                reverse_proxy supabase-kong:8000 {
                        transport http {
                                read_timeout 60s
                                write_timeout 60s
                                dial_timeout 5s
                        }
                }
                header Cache-Control "no-store, no-cache, must-revalidate, private"
                header Pragma "no-cache"
        }

        @supabase_api path /api/rest/v1/* /api/realtime/v1/* /api/storage/v1/*
        handle @supabase_api {
                uri strip_prefix /api
                reverse_proxy supabase-kong:8000 {
                        transport http {
                                read_timeout 60s
                                write_timeout 60s
                                dial_timeout 5s
                        }
                }
        }

        # Остальные /api/* — Route Handlers Next.js.
        # Доверенный прокси (v4.6): топология A (прямой клиент) / B (cloudflared).
        handle /api/* {
                # Топология B: peer — локальный cloudflared
                reverse_proxy @loopback_peer web:3000 {
                        header_up X-Real-IP {header.CF-Connecting-IP}
                        # Health check — опрашивает /api/health каждые 10с
                        health_uri /api/health
                        health_interval 10s
                        # Таймауты для медленных API (генерация PDF, поиск, и т.д.)
                        transport http {
                                read_timeout 60s
                                write_timeout 60s
                                dial_timeout 5s
                        }
                }
                # Топология A: peer — прямой клиент
                reverse_proxy web:3000 {
                        header_up X-Real-IP {remote_host}
                        header_up -CF-Connecting-IP
                        health_uri /api/health
                        health_interval 10s
                        transport http {
                                read_timeout 60s
                                write_timeout 60s
                                dial_timeout 5s
                        }
                }
                header Cache-Control "no-store, no-cache, must-revalidate, private"
                header Pragma "no-cache"
        }

        # WebSocket (Socket.IO чат)
        handle /socket.io/* {
                reverse_proxy @loopback_peer chat-service:3030 {
                        header_up X-Real-IP {header.CF-Connecting-IP}
                        # WebSocket требует долгих таймаутов
                        transport http {
                                read_timeout 300s
                                write_timeout 300s
                        }
                }
                reverse_proxy chat-service:3030 {
                        header_up X-Real-IP {remote_host}
                        header_up -CF-Connecting-IP
                        transport http {
                                read_timeout 300s
                                write_timeout 300s
                        }
                }
        }

        # n8n (вебхуки автоматизации) — защищён basic auth внутри n8n.
        # v4.6: та же политика доверенного X-Real-IP, что для web/chat —
        # n8n пишет client IP в логи/execution data; без перезаписи клиент
        # подделывал бы заголовок в журналах автоматизации.
        handle /n8n/* {
                reverse_proxy @loopback_peer n8n:5678 {
                        header_up X-Real-IP {header.CF-Connecting-IP}
                }
                reverse_proxy n8n:5678 {
                        header_up X-Real-IP {remote_host}
                        header_up -CF-Connecting-IP
                }
        }

        # Health-check endpoint для Cloudflare Tunnel / UptimeRobot
        # Возвращает 200 OK даже если Next.js ещё стартует — Caddy живой
        handle /healthz {
                respond "OK" 200
        }

        # Всё остальное — Next.js (SSR/SSG)
        handle {
                reverse_proxy @loopback_peer web:3000 {
                        header_up X-Real-IP {header.CF-Connecting-IP}
                        health_uri /api/health
                        health_interval 10s
                        transport http {
                                read_timeout 30s
                                write_timeout 30s
                                dial_timeout 5s
                        }
                }
                reverse_proxy web:3000 {
                        header_up X-Real-IP {remote_host}
                        header_up -CF-Connecting-IP
                        health_uri /api/health
                        health_interval 10s
                        transport http {
                                read_timeout 30s
                                write_timeout 30s
                                dial_timeout 5s
                        }
                }
                # Fallback — если web совсем мёртв, показываем статичную страницу
                # (раскомментировать после создания /var/www/maintenance.html)
                # handle_response 503 {
                #       root * /var/www
                #       file_server maintenance.html
                # }
        }

        # ===== Безопасность (security headers) =====
        header {
                # MIME-type sniffing protection
                X-Content-Type-Options nosniff
                # Clickjacking: разрешаем встраивание только в iframe preview-платформы
                X-Frame-Options SAMEORIGIN
                # Referrer policy
                Referrer-Policy strict-origin-when-cross-origin
                # Permissions-Policy — отключаем всё лишнее
                Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
                # HSTS — принудительный HTTPS на 1 год + preload
                Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                # Cross-Origin políticas (изолируем от других страниц)
                Cross-Origin-Opener-Policy same-origin
                Cross-Origin-Resource-Policy same-origin
                # Убираем X-Powered-By (Caddy добавляет свой, но мы убираем серверный)
                -Server
                # CORS для API (ограниченный)
                Access-Control-Allow-Origin "https://conditera.ru"
                Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
                Access-Control-Allow-Headers "Content-Type, Authorization, X-CSRF-Token, X-Requested-With"
                Access-Control-Allow-Credentials "true"
                # Cache-Control для sensitive endpoints (по умолчанию)
                # Cache-Control "no-store" — для /api/auth/* (см. отдельный блок ниже)
        }

        # ===== Сжатие =====
        encode gzip zstd

        # ===== Логирование =====
        log {
                output file /data/access.log {
                        roll_size 100mb
                        roll_keep 10
                        roll_keep_for 720h
                }
                format json
        }

        # ===== Rate-limit через Caddy (защита от DDoS на уровне прокси) =====
        # 10 запросов/сек на один IP, burst 20
        # (дополнительно к app-level rate limiting в Next.js)
        # Требует плагин mholt/caddy-ratelimit — раскомментировать после установки:
        # rate_limit {
        #       zone dynamic {
        #               key {remote_host}
        #               events 10
        #               window 1s
        #       }
        # }
}

# SimpleX SMP сервер — отдельный блок (порт 5223 проксируем в Caddy)
# Альтернатива: открываем порт 5223 напрямую (см. docker-compose)
smp.conditera.ru {
        reverse_proxy smp-server:5223 {
                transport http {
                        # SimpleX использует TCP+TLS, не HTTP — этот блок только если проксируем
                        # через Caddy. Обычно SMP-сервер открывается напрямую на 5223.
                }
        }
        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        }
}

# Для localhost (разработка без домена)
localhost {
        reverse_proxy web:3000 {
                # Дев-паритет с prod: приложение доверяет только переписанному
                # X-Real-IP. Дев-топология без туннеля: пир = локальный клиент.
                header_up X-Real-IP {remote_host}
                header_up -CF-Connecting-IP
        }
}

# ===== Cloudflare Tunnel: recommended config.yml =====
# На сервере, где запущен cloudflared, ~/.cloudflared/config.yml должен содержать:
#
#   tunnel: <tunnel-id>
#   credentials-file: /root/.cloudflared/<tunnel-id>.json
#   protocol: http2
#   ingress:
#     - hostname: conditera.ru
#       service: http://localhost:80    # Caddy (НЕ web:3000 напрямую!)
#     - hostname: www.conditera.ru
#       service: http://localhost:80
#     - service: http_status:404
#
# После правки: sudo systemctl restart cloudflared
# Проверка: cloudflared tunnel info <tunnel-name>
