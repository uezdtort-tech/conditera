{
  "name": "✅ Обработка заказов — авто-подтверждение для верифицированных кондитеров",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Каждые 15 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/api/orders?status=PENDING&autoApproveEligible=1",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Auth",
              "value": "={{ $env.N8N_SERVICE_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-pending",
      "name": "Найти PENDING-заказы",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "orders",
        "options": {}
      },
      "id": "split-orders",
      "name": "Разделить по заказам",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-verified",
              "leftValue": "={{ $json.confectionerVerified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cond-auto-eligible",
              "leftValue": "={{ $json.autoApproveEligible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-verified",
      "name": "Если кондитер верифицирован",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/orders/{{ $json.id }}/accept",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.N8N_CONFECTIONER_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {}
      },
      "id": "auto-accept",
      "name": "Авто-подтвердить заказ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {},
      "id": "skip-order",
      "name": "Пропустить",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/cron/status",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cron-Secret",
              "value": "={{ $env.CRON_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"order-processing\",\n  \"status\": \"success\",\n  \"checked\": {{ $node[\"Разделить по заказам\"].items.length }},\n  \"autoAccepted\": {{ $node[\"Авто-подтвердить заказ\"].items.length }},\n  \"checkedAt\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "log-status",
      "name": "Записать статус",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1340,
        300
      ]
    }
  ],
  "connections": {
    "Каждые 15 минут": {
      "main": [
        [
          {
            "node": "Найти PENDING-заказы",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Найти PENDING-заказы": {
      "main": [
        [
          {
            "node": "Разделить по заказам",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Разделить по заказам": {
      "main": [
        [
          {
            "node": "Если кондитер верифицирован",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Если кондитер верифицирован": {
      "main": [
        [
          {
            "node": "Авто-подтвердить заказ",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Пропустить",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Авто-подтвердить заказ": {
      "main": [
        [
          {
            "node": "Записать статус",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Пропустить": {
      "main": [
        [
          {
            "node": "Записать статус",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "orders"
    },
    {
      "name": "automation"
    }
  ],
  "id": "c7429268-f4e7-5bd1-82d4-879e9b533dca"
}