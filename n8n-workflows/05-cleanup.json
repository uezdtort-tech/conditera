{
  "name": "🧹 Очистка старых данных — ежедневный cleanup",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Ежедневно 04:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/api/cron/cleanup",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cron-Secret",
              "value": "={{ $env.CRON_SECRET }}"
            }
          ]
        },
        "timeout": 300000,
        "options": {}
      },
      "id": "run-cleanup",
      "name": "Запустить cleanup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/cron/status",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cron-Secret",
              "value": "={{ $env.CRON_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"cleanup\",\n  \"status\": \"success\",\n  \"duration\": {{ $json.totalDurationMs }},\n  \"notified\": {{ $json.totalDeleted }},\n  \"operations\": {{ JSON.stringify($json.operations) }}\n}",
        "options": {}
      },
      "id": "log-status",
      "name": "Записать статус",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Ежедневно 04:00": {
      "main": [
        [
          {
            "node": "Запустить cleanup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Запустить cleanup": {
      "main": [
        [
          {
            "node": "Записать статус",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "maintenance"
    },
    {
      "name": "cleanup"
    }
  ],
  "id": "f79798a9-61cd-5561-81f3-0e373ed9212e"
}