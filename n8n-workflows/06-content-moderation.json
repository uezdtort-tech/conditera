{
  "name": "🛡️ Модерация контента — авто-проверка отзывов и постов",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "content-moderation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "trigger-webhook",
      "name": "Webhook: новый контент",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "content-moderation-trigger"
    },
    {
      "parameters": {
        "jsCode": "// Авто-модерация: ищем запрещённые паттерны и спам\nconst payload = $input.first().json.body || $input.first().json;\nconst text = String(payload.text || '').toLowerCase();\nconst contentId = payload.contentId || payload.id;\nconst contentType = payload.contentType || 'review';\nconst authorId = payload.authorId;\n\n// Запрещённые слова/фразы\nconst prohibited = ['казино', 'ставки', 'наркотик', 'оружие', 'порно', 'обман'];\n// Спам-паттерны: капслок, повторяющиеся символы, много ссылок\nconst spamPatterns = [\n  /(.)\\1{9,}/i,            // 10+ одинаковых символов подряд\n  /(https?:\\/\\/[^\\s]+\\s*){3,}/i, // 3+ ссылок\n  /^[^a-zа-я0-9\\s]+$/i,    // только спецсимволы\n];\nconst capsRatio = (text.replace(/[^A-ZА-Я]/g, '').length) / Math.max(text.replace(/[^a-zа-яA-ZА-Я]/g, '').length, 1);\n\nconst reasons = [];\nfor (const w of prohibited) {\n  if (text.includes(w)) reasons.push(`prohibited_word:${w}`);\n}\nfor (const re of spamPatterns) {\n  if (re.test(text)) reasons.push(`spam_pattern:${re.source.slice(0, 20)}`);\n}\nif (capsRatio > 0.6 && text.length > 30) reasons.push('excessive_caps');\nif (text.trim().length < 5) reasons.push('too_short');\n\nreturn [{\n  json: {\n    contentId,\n    contentType,\n    authorId,\n    text: text.slice(0, 500),\n    isFlagged: reasons.length > 0,\n    reasons,\n    status: reasons.length > 0 ? 'flagged' : 'approved',\n    checkedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "scan-content",
      "name": "Сканировать контент",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-flagged",
              "leftValue": "={{ $json.isFlagged }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-flagged",
      "name": "Если нарушений найдены",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
