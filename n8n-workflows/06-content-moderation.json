        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"content_moderation\",\n  \"data\": {\n    \"contentId\": \"{{ $json.contentId }}\",\n    \"contentType\": \"{{ $json.contentType }}\",\n    \"authorId\": \"{{ $json.authorId }}\",\n    \"status\": \"flagged\",\n    \"reasons\": {{ JSON.stringify($json.reasons) }},\n    \"checkedAt\": \"{{ $json.checkedAt }}\"\n  }\n}",
        "options": {}
      },
      "id": "send-flagged",
      "name": "Отправить flagged",
