{
  "name": "24. AI Fillings Moderation",
  "nodes": [
    {
      "parameters": {
        "path": "fillings-moderation",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "fillings-moderation-webhook"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "systemPrompt",
              "value": "Ты — модератор кондитерской платформы «Уездный кондитер». Проверь название и описание начинки на: 1) Корректность (не дубликат) 2) Отсутствие спама/рекламы 3) Отсутствие оскорблений 4) Соответствие кондитерской тематике. Верни JSON: {\"approved\": true/false, \"reason\": \"причина отклонения или пусто\", \"suggestions\": \"улучшения если есть\"}"
            },
            {
              "name": "userMessage",
              "value": "Проверь начинку: {{$json.filling_name}} - {{$json.filling_description}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Prepare Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OLLAMA_HOST || 'http://host.docker.internal:11434'}}/v1/chat/completions",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{$env.LLM_MODEL || 'qwen2.5:7b'}}"
            },
            {
              "name": "messages",
              "value": "=[{\"role\":\"system\",\"content\":\"{{$json.systemPrompt}}\"},{\"role\":\"user\",\"content\":\"{{$json.userMessage}}\"}]"
            },
            {
              "name": "stream",
              "value": false
            },
            {
              "name": "temperature",
              "value": 0.3
            },
            {
              "name": "max_tokens",
              "value": 300
            },
            {
              "name": "format",
              "value": "json"
            }
          ]
        },
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "name": "Ollama AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "response",
              "value": "={{$json.choices[0].message.content}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Extract Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Prompt": {
      "main": [
        [
          {
            "node": "Ollama AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama AI": {
      "main": [
        [
          {
            "node": "Extract Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Response": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "tags": [
    {
      "name": "AI"
    },
    {
      "name": "Moderation"
    },
    {
      "name": "Fillings"
    }
  ],
  "notes": "AI-модерация начинок через Ollama.\n\nАвтоматически проверяет новые начинки от кондитеров:\n- Корректность названия\n- Отсутствие спама\n- Соответствие тематике\n\nВозвращает JSON с решением approved/rejected.\nEndpoint: POST http://localhost:5678/webhook/fillings-moderation\nBody: { \"filling_name\": \"...\", \"filling_description\": \"...\" }",
  "id": "39c5908b-fc68-5fb0-b8d4-9f0c3dcf0a2a"
}