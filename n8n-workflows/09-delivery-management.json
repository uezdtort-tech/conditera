{
  "name": "🚚 Управление доставкой — авто-назначение курьеров",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Каждые 30 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/api/courier/available-orders?status=READY&unassigned=1",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Auth",
              "value": "={{ $env.N8N_SERVICE_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-ready-orders",
      "name": "Найти READY-заказы без курьера",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "orders",
        "options": {}
      },
      "id": "split-orders",
      "name": "Разделить по заказам",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/courier/assign",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.N8N_COURIER_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"orderId\": \"{{ $json.id }}\"\n}",
        "options": {}
      },
      "id": "assign-courier",
      "name": "Назначить курьера",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/cron/status",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cron-Secret",
              "value": "={{ $env.CRON_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"delivery-management\",\n  \"status\": \"success\",\n  \"assigned\": {{ $node[\"Разделить по заказам\"].items.length }},\n  \"checkedAt\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "log-status",
      "name": "Записать статус",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Каждые 30 минут": {
      "main": [
        [
          {
            "node": "Найти READY-заказы без курьера",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Найти READY-заказы без курьера": {
      "main": [
        [
          {
            "node": "Разделить по заказам",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Разделить по заказам": {
      "main": [
        [
          {
            "node": "Назначить курьера",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Назначить курьера": {
      "main": [
        [
          {
            "node": "Записать статус",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "delivery"
    },
    {
      "name": "courier"
    }
  ],
  "id": "a2797c18-6f0e-5957-ad8f-6a86522e442a"
}