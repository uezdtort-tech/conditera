# ===== Dockerfile для simplex-bridge =====
# Debian/glibc необходимы для официального Ubuntu-бинарника SimpleX CLI.
# Node 26 запускает TypeScript с нативным type stripping без ts-node/loader.

FROM node:26-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      dumb-init wget ca-certificates file libgmp10 libpq5 libsqlite3-0 libssl3 zlib1g \
    && rm -rf /var/lib/apt/lists/*

# SimpleX Chat CLI: фиксированная версия; проверяем ELF и отсутствие
# недостающих динамических библиотек прямо при сборке образа.
RUN wget -qO /usr/local/bin/simplex-chat \
      "https://github.com/simplex-chat/simplex-chat/releases/download/v7.1.4/simplex-chat-ubuntu-22_04-x86-64" \
    && chmod +x /usr/local/bin/simplex-chat \
    && test -s /usr/local/bin/simplex-chat \
    && file /usr/local/bin/simplex-chat | grep -q "ELF" \
    && (ldd /usr/local/bin/simplex-chat || true) > /tmp/simplex-ldd.txt \
    && if grep -q "not found" /tmp/simplex-ldd.txt; then cat /tmp/simplex-ldd.txt; exit 1; fi \
    && rm /tmp/simplex-ldd.txt

# Зависимости bridge
COPY mini-services/simplex-bridge/package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# Код bridge
COPY mini-services/simplex-bridge/index.ts ./

ENV SIMPLEX_CLI_PORT=5225
ENV BRIDGE_PORT=5226

EXPOSE 5226

HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=6 \
  CMD wget -qO- http://localhost:5226/health | grep -q '"cliConnected":true' && wget -qO- http://localhost:5226/health | grep -q '"isInitialized":true' || exit 1

# Node 26 стабильно поддерживает erasable TypeScript syntax без ts-node.
CMD ["dumb-init", "sh", "-c", "simplex-chat --chat-server-port ${SIMPLEX_CLI_PORT} --database /data/simplex --create-bot-display-name \"${SIMPLEX_PROFILE_NAME:-Conditera}\" --yes-migrate & exec node index.ts"]
