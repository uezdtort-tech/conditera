# ===== Dockerfile для simplex-bridge =====
# Запускает simplex-chat CLI + bot-мост на порту 5226
#
# ВАЖНО: URL для скачивания simplex-chat CLI часто меняется между релизами.
# Если сборка падает на wget — проверьте актуальный asset на:
#   https://github.com/simplex-chat/simplex-chat/releases
# Ищите файл вида simplex-chat-ubuntu-XX_04-x86-64
#
# v2 (e2e-fix): runtime переведён с node+ts-node на bun — ts-node отсутствовал
# в зависимостях bridge, и `node --loader ts-node/esm` падал на старте контейнера.
# Также в apk добавлен `file` (использовался проверкой ELF, но не был установлен).

# v3 (registry-hardening): oven/bun публичных зеркал не имеет, а Docker Hub ловит
# 429 в GH Actions — берём node из public.ecr.aws и ставим bun CLI из npm (musl).
FROM public.ecr.aws/docker/library/node:20-alpine

WORKDIR /app

# dumb-init + ca-certs + file (проверка ELF у скачанного CLI) + bun CLI из npm +
# simplex-chat CLI. Используем конкретную версию v6.2.0 (стабильный asset
# simplex-chat-ubuntu-22_04-x86-64)
RUN apk add --no-cache dumb-init wget ca-certificates file && \
    npm install -g bun@1 && \
    wget -qO /usr/local/bin/simplex-chat \
      "https://github.com/simplex-chat/simplex-chat/releases/download/v6.2.0/simplex-chat-ubuntu-22_04-x86-64" && \
    chmod +x /usr/local/bin/simplex-chat && \
    test -s /usr/local/bin/simplex-chat && \
    file /usr/local/bin/simplex-chat | grep -q "ELF"

# Зависимости bridge (bun.lock копируем ДО установки — иначе --frozen-lockfile падает)
COPY mini-services/simplex-bridge/package.json ./
COPY mini-services/simplex-bridge/bun.lock* ./
RUN bun install --frozen-lockfile

# Код bridge
COPY mini-services/simplex-bridge/index.ts ./

# Конфигурация SimpleX CLI (профиль, опции)
ENV SIMPLEX_CLI_PORT=5225
ENV BRIDGE_PORT=5226

EXPOSE 5226

# Healthcheck: проверяем bridge HTTP endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:5226/health > /dev/null 2>&1 || exit 1

# Старт: simplex-chat CLI в фоне → bridge подключается к нему
CMD ["dumb-init", "sh", "-c", \
     "simplex-chat -p ${SIMPLEX_CLI_PORT} --database /app/simplex.db --no-tui & sleep 2 && bun index.ts"]
