// ===== ПРОВЕРКА ОРГАНИЗАЦИЙ (DaData Party API) =====
// Хранит результаты проверок ИНН/ОГРН через DaData.
// Используется при регистрации юрлиц, при выставлении счетов,
// и регулярной cron-задачей для повторной проверки активных.
enum OrganizationStatus {
  ACTIVE // действующая
  LIQUIDATING // в процессе ликвидации
  LIQUIDATED // ликвидирована
  REORGANIZING // в процессе реорганизации
  UNKNOWN // не найдена в DaData
}

enum VerificationTrigger {
  REGISTRATION // при регистрации
  PROFILE_UPDATE // при обновлении профиля
  INVOICE_ISSUE // при выставлении счёта
  PAYOUT_REQUEST // при запросе на выплату
  CRON_PERIODIC // регулярная проверка
  ADMIN_MANUAL // ручная проверка админом
}

model OrganizationVerification {
  id             String              @id @default(cuid())
  userId         String? // на кого ссылается (пользователь)
  confectionerId String? // или кондитер
  inn            String // ИНН проверенной организации
  ogrn           String? // ОГРН/ОГРНИП
  kpp            String? // КПП (для ООО)
  companyName    String // наименование из DaData
  fullName       String? // полное наименование
  opfCode        String? // код ОПФ (12300=ООО, 50102=ИП)
  opfShort       String? // короткая форма (ООО, ИП)
  status         OrganizationStatus  @default(UNKNOWN)
  // Подробности от DaData
  managementName String? // ФИО руководителя
  managementPost String? // должность
  legalAddress   String? // юр. адрес
  registeredAt   DateTime? // дата регистрации
  liquidatedAt   DateTime? // дата ликвидации (если есть)
  // Метаданные проверки
  trigger        VerificationTrigger
  success        Boolean             @default(false) // успешно ли прошла проверка
  errorMessage   String? // ошибка если success=false
  rawData        Json? // полный ответ DaData
  // Действия, предпринятые по результату
  actionTaken    String? // "blocked" | "suspended" | "notified" | "approved"
  verifiedBy     String? // userId админа (для ADMIN_MANUAL)
  createdAt      DateTime            @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  confectioner Confectioner? @relation(fields: [confectionerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([confectionerId])
  @@index([inn])
  @@index([status])
  @@index([createdAt])
  @@map("organization_verifications")
}

// ===== ОБСЛУЖИВАНИЕ: backup + cleanup =====
enum MaintenanceType {
  BACKUP_FULL // полный backup БД
  BACKUP_INCREMENTAL // инкрементальный (только изменения с последнего backup)
  CLEANUP_LOGS // очистка старых логов
  CLEANUP_SESSIONS // очистка истёкших сессий
  CLEANUP_NOTIFICATIONS // удаление старых прочитанных уведомлений
  CLEANUP_CARTS // удаление брошенных корзин
  CLEANUP_ORPHANS // удаление записей без связей
  VACUUM // VACUUM ANALYZE (PostgreSQL)
}

enum MaintenanceStatus {
  queued
  running
  success
  failed
  partial
}

model MaintenanceLog {
  id              String            @id @default(cuid())
  type            MaintenanceType
  status          MaintenanceStatus @default(queued)
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  // Результаты
  recordsAffected Int? // сколько записей удалено/обработано
  backupPath      String? // путь к файлу backup (для BACKUP_*)
  backupSizeBytes Int? // размер backup файла
  tablesCount     Int? // количество таблиц в backup
  // Детали
  details         Json? // детальная статистика по таблицам
  errorMessage    String?
  triggeredBy     String? // userId админа или "cron"
  createdAt       DateTime          @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("maintenance_logs")
}

// ===== НАЧИНКИ ДЛЯ ТОРТОВ (с модерацией) =====
enum FillingStatus {
  APPROVED // одобрено администратором, доступно всем
  PENDING // ожидает модерации (добавлено кондитером)
  REJECTED // отклонено администратором
}

enum FillingCategory {
  CREAM // кремовые (пломбир, чиз, маскарпоне)
  CHOCOLATE // шоколадные (ганаш, мусс)
  BERRY // ягодные (клубника, малина, вишня)
  CARAMEL // карамельные (сгущёнка, солёная карамель)
  NUT // ореховые (фисташка, миндаль, фундук)
  FRUIT // фруктовые (манго, персик, маракуйя)
  CLASSIC // классические (медовик, наполеон, прага)
  MOUSSE // муссовые
  CUSTARD // заварные (патисьер, англемаз)
  OTHER // прочие
}

model Filling {
  id                     String          @id @default(cuid())
  name                   String          @unique
  slug                   String          @unique
  description            String // подробное описание (состав, вкус, текстура)
  category               FillingCategory @default(OTHER)
  // Изображение (URL)
  image                  String?
  // Аллергены
  allergens              String[]        @default([])
  // Согласованность/тип
  consistency            String? // "густой крем", "жидкий", "плотный мусс"
  // Цвет (для визуального выбора в конструкторе)
  color                  String? // hex color, e.g. "#FFF5E1"
  // === Срез торта (новый тренд) ===
  // Загруженное изображение среза (фотография реального торта)
  sliceImage             String?
  // SVG-конфигурация среза (для визуализатора): { layers: [{type, color, label}], coating, decoration }
  // Если есть — генерируется визуализатором, можно редактировать
  sliceConfig            Json?
  // Кто создал конфигурацию среза (null = системная начинка с дефолтным срезом)
  sliceConfigCreatedBy   String?
  // Средняя наценка (рекомендованная)
  suggestedPriceModifier Int             @default(0) // в рублях
  // Статус модерации
  status                 FillingStatus   @default(APPROVED)
  // Кто добавил
  createdBy              String? // userId кондитера (null = системная)
  createdByName          String? // имя кондитера
  // Модерация
  reviewedBy             String? // userId админа
  reviewedAt             DateTime?
  rejectionReason        String? // причина отклонения
  // Метрики
  usageCount             Int             @default(0) // сколько раз использовано в товарах
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([status])
  @@index([category])
  @@index([slug])
  @@map("fillings")
}

// ===== Срезы торта для продуктов =====
// Позволяет кондитеру загрузить/смоделировать срез торта
// для конкретного продукта (а не только для начинки в общем).
// Один продукт может иметь несколько срезов (по разным начинкам).
model ProductSlice {
  id          String   @id @default(cuid())
  productId   String
  fillingName String // название начинки (например "Шоколадный бисквит + ганаш")
  // Загруженное изображение (URL)
  image       String?
  // SVG-конфигурация для визуализатора
  config      Json?
  // Подпись (опционально)
  caption     String?
  // Порядок отображения
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([fillingName])
  @@map("product_slices")
}

// ===== LIVE-COMMERCE: Стримы кондитеров =====
// Кондитер ведёт трансляцию процесса украшения торта, зрители заказывают в чате.
model LiveStream {
  id             String    @id @default(cuid())
  confectionerId String
  // Заголовок и описание стрима
  title          String
  description    String?
  // Превью (обложка)
  thumbnailUrl   String?
  // Статус: scheduled | live | ended
  status         String    @default("scheduled")
  // Источник видео
  streamUrl      String? // HLS .m3u8 для плеера
  streamKey      String? // ключ для OBS (не публичный)
  // Связанный товар (если стрим посвящён конкретному торту)
  productId      String?
  // Метрики
  viewersCount   Int       @default(0)
  peakViewers    Int       @default(0)
  totalViewers   Int       @default(0) // уникальные
  likesCount     Int       @default(0)
  ordersCount    Int       @default(0) // заказы во время стрима
  revenue        Int       @default(0) // выручка за стрим
  // Запись (VOD после завершения)
  recordUrl      String?
  // Расписание
  scheduledAt    DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([confectionerId])
  @@index([status])
  @@index([scheduledAt])
  @@map("live_streams")
}

// Зрители стрима (для подсчёта уникальных и истории)
model LiveStreamViewer {
  id        String    @id @default(cuid())
  streamId  String
  userId    String?
  // Анонимный sessionId если не авторизован
  sessionId String?
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  // Время просмотра (сек)
  watchTime Int       @default(0)
  // Лайкнул ли стрим
  liked     Boolean   @default(false)
  // Сделал ли заказ
  ordered   Boolean   @default(false)

  @@index([streamId])
  @@index([userId])
  @@map("live_stream_viewers")
}

// Заказы, сделанные во время стрима (для расчёта выручки)
model LiveStreamOrder {
  id        String   @id @default(cuid())
  streamId  String
  orderId   String
  userId    String
  createdAt DateTime @default(now())

  @@unique([streamId, orderId])
  @@index([streamId])
  @@map("live_stream_orders")
}

// Чат стрима (отдельно от обычного чата, для модерации)
model LiveStreamMessage {
  id         String   @id @default(cuid())
  streamId   String
  userId     String?
  sessionId  String?
  userName   String // отображаемое имя
  userAvatar String?
  text       String
  // Закреплено модератором
  pinned     Boolean  @default(false)
  // Удалено (модерацией)
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([streamId])
  @@index([userId])
  @@index([createdAt])
  @@map("live_stream_messages")
}

// ===== PUSH-ПОДПИСКИ (Web Push / VAPID) =====
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ===== ПРОМОКОДЫ =====
// P2: Серверная валидация промокодов (expiry, usage limit, role, minOrderAmount).
// Связан с Order через orderId — один промокод = одна запись на заказ.
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique // UV-промокод, UPPER-CASE
  description     String?
  // Тип скидки
  discountType    String   @default("percent") // "percent" | "fixed"
  discountValue   Float    @default(0) // 10 = 10% или 500 = 500₽
  maxDiscountRub  Int? // cap для percent
  // Применимость
  minOrderAmount  Int      @default(0) // минимум корзины
  applicableRoles String[] @default([]) // CUSTOMER/CONFECTIONER/...; пусто = все
  confectionerId  String? // null = любой кондитер
  // Срок действия
  startDate       DateTime @default(now())
  endDate         DateTime
  // Лимиты
  maxUses         Int? // null = безлимит
  maxUsesPerUser  Int      @default(1)
  usedCount       Int      @default(0)
  // Создатель
  createdBy       String? // userId админа/кондитера
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[] @relation("OrderPromoCode")

  @@index([code])
  @@index([confectionerId])
  @@index([isActive])
  @@map("promo_codes")
}

// ===== 2FA верификации (временные коды) =====
// Лог одноразовых кодов для подтверждения 2FA-операций.
// Запись создаётся при попытке операции, удаляется после успеха/экспирации.
model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  operation String // "payout" | "login" | "settings" | "delete_account"
  codeHash  String // bcrypt-хэш 6-значного кода (или TOTP-валидация)
  attempts  Int      @default(0) // счётчик неудачных попыток (max 5)
  resolved  Boolean  @default(false)
  expiresAt DateTime // 5 минут жизни
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

// ===== ANTI-FRAUD: лог заказов по IP/устройству =====
// Для rate-limit: максимум N заказов с IP/устройства в час.
// cron /api/cron/cleanup удаляет записи старше 24 часов.
model OrderFraudLog {
  id        String   @id @default(cuid())
  ipHash    String // SHA-256 hash IP (не храним raw IP)
  deviceFp  String? // fingerprint браузера (если передан клиентом)
  userId    String? // userId если авторизован
  orderId   String?
  action    String // "order_create" | "register" | "login" | "review"
  createdAt DateTime @default(now())

  @@index([ipHash])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("order_fraud_logs")
}

// ===== ЭСКАЛАЦИИ ОПЕРАТОРУ =====
// Когда авточат не справился — создаётся эскалация.
// Оператор видит её в своём дашборде и принимает в работу.
model OperatorEscalation {
  id         String    @id @default(cuid())
  roomId     String // чат, откуда эскалация
  userId     String // пользователь, запросивший оператора
  userName   String
  reason     String // "manual_request" | "bot_unknown" | "complaint" | "dispute"
  message    String // текст последнего сообщения пользователя
  status     String    @default("pending") // "pending" | "assigned" | "resolved"
  assignedTo String? // userId оператора
  assignedAt DateTime?
  resolvedAt DateTime?
  resolution String? // "answered" | "redirected" | "no_action"
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("operator_escalations")
}

// ============================================================================
// ТЗ v3.45 — РАСШИРЕНИЕ СХЕМЫ
// Все новые модели используют строковые FK (без @relation к User/Confectioner),
// чтобы не модифицировать существующие модели. Паттерн соответствует модели
// Payment (orderId: String + @@index). При необходимости relations добавляются
// миграцией позже.
// ============================================================================

// ===== AUTH & SESSIONS =====
// OAuth-аккаунты (Yandex/VK/Google и т.д.)
model Account {
  id                    String    @id @default(cuid())
  userId                String
  provider              String // "google" | "yandex" | "vk" | "apple"
  providerAccountId     String
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  tokenType             String?   @default("Bearer")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Сессии пользователей
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Refresh-токены
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

// ===== ПРОФИЛИ ПО РОЛЯМ =====
// (Confectioner уже существует — отдельный ConfectionerProfile не нужен)

// Профиль курьера
model CourierProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  transport       String   @default("bike") // "bike" | "car" | "foot" | "public"
  availability    String[] @default([]) // рабочие дни
  region          String?
  rating          Float    @default(0)
  deliveriesCount Int      @default(0)
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region])
  @@index([isActive])
  @@map("courier_profiles")
}

// Профиль поставщика
model SupplierProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  companyName    String
  inn            String?
  deliveryTerms  String?
  minOrderAmount Int      @default(0)
  regions        String[] @default([])
  rating         Float    @default(0)
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([inn])
  @@index([isActive])
  @@map("supplier_profiles")
}

// Профиль покупателя
model CustomerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  loyaltyLevel String   @default("BRONZE")
  bonusBalance Int      @default(0)
  preferences  Json?
  totalOrders  Int      @default(0)
