// Prisma schema for "Уездный кондитер" marketplace
// PostgreSQL — real production database (also runs locally via PGlite WASM adapter)
//
// ВАЖНО: Начиная с Prisma v7, URL datasource берётся из prisma/prisma.config.ts.
// В schema.prisma остаётся только указание провайдера БД.
// См. https://www.prisma.io/docs/orm/prisma-schema/overview/data-sources

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== РОЛИ (enum) =====
// ТЗ v3.45: 22 роли + доп. роли для расширенной схемы
enum UserRole {
  // Базовые роли
  CUSTOMER
  CONFECTIONER
  ADMIN
  SUPER_ADMIN
  COURIER
  SUPPLIER
  VENUE_OWNER
  ANIMATOR_AGENCY
  RECREATION_CENTER
  KIDS_CLUB
  // Расширенные роли (ТЗ v3.45)
  GUEST
  MODERATOR
  SUPPORT
  STUDIO
  BLOGGER
  TASTER
  FRANCHISEE
  NUTRITIONIST
  CORPORATE_CLIENT
  QUALITY_INSPECTOR
  CERTIFICATION_AGENT
  COPYWRITER
  FOOD_SERVICE
  EVENT_ORGANIZER
  PICKUP_POINT
  WHOLESALER
}

enum LoyaltyLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum AccountType {
  individual
  legal
}

enum TrustLevel {
  NEW
  VERIFIED
  MASTER
  EXPERT
}

enum Tariff {
  START
  BASIC
  PREMIUM
  BUSINESS
}

enum TaxMode {
  NPD
  USN
  OSNO
  PSN
  SELF_EMPLOYED
}

enum OrderStatus {
  PENDING
  NEGOTIATING
  CONFIRMED
  PREPARING
  READY
  IN_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  pending
  waiting_for_capture
  succeeded
  escrow
  released
  cancelled
  refunded
}

enum PaymentMethod {
  card
  sbp
  cash
  split
  installment
  yookassa
  self
}

enum LoyaltyTxType {
  EARN
  REDEEM
  EXPIRE
  REFUND
  ADJUST
  BONUS_WELCOME
  BONUS_BIRTHDAY
  BONUS_REFERRAL
}

enum NotificationChannel {
  email
  sms
  push
  in_app
  telegram
}

enum NotificationStatus {
  queued
  sent
  delivered
  failed
  read
  dismissed
}

enum NotificationTemplate {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_STATUS_CHANGED
  ORDER_ACCEPTED
  ORDER_IN_PRODUCTION
  ORDER_READY
  ORDER_READY_FOR_PICKUP
  ORDER_OUT_FOR_DELIVERY
  ORDER_RECEIVED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCEEDED
  PAYMENT_PARTIAL
  PAYMENT_FAILED
  REFUND_PROCESSED
  NEGOTIATION_RECEIVED
  NEGOTIATION_QUOTED
  NEGOTIATION_APPROVED
  NEGOTIATION_REJECTED
  NEW_MESSAGE
  NEW_REVIEW
  REVIEW_REPLY
  BONUS_EARNED
  BONUS_EXPIRING
  LEVEL_UP
  BIRTHDAY_GREETING
  REFERRAL_REWARDED
  PROMO_NEAR_YOU
  ABANDONED_CART
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  PAYOUT_PROCESSED
  SUPPORT_REPLY
}

// ===== ПОЛЬЗОВАТЕЛИ =====
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  phone          String?
  avatar         String?
  roles          UserRole[]   @default([CUSTOMER])
  accountType    AccountType  @default(individual)
  legalInfo      Json?
  city           String?
  loyaltyLevel   LoyaltyLevel @default(BRONZE)
  bonusBalance   Int          @default(0)
  isBlocked      Boolean      @default(false)
  blockedReason  String?
  // 2FA / TOTP
  tfaSecret      String? // base32-секрет для TOTP (шифрованный)
  tfaEnabled     Boolean      @default(false)
  tfaBackupCodes String[]     @default([]) // хэши backup-кодов
  tfaRequiredFor String[]     @default([]) // ["payout", "login", "settings"]
  // Anti-fraud: последний IP входа
  lastLoginIp    String?
  lastLoginAt    DateTime?
  // Bot-flag: системный пользователь-бот (auto-chat assistant)
  isBot          Boolean      @default(false)
  botRole        String? // "order_assistant" | "support" | "faq"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  confectioner     Confectioner?
  orders           Order[]
  cartItems        CartItem[]
  reviews          Review[]
  chatMessages     ChatMessage[]
  promotions       Promotion[]
  recipes          Recipe[]
  referrals        Referral?
  giftCertsFrom    GiftCertificate[]          @relation("fromUser")
  giftCertsTo      GiftCertificate[]          @relation("toUser")
  holidays         UserHoliday[]
  videoReviews     VideoReview[]
  loyaltyTxs       LoyaltyTransaction[]
  notifications    Notification[]
  notifyPrefs      NotificationPreferences?
  orgVerifications OrganizationVerification[]
  simplexContacts  SimpleXContact[]

  @@index([city])
  @@index([isBlocked])
  @@map("users")
}

// ===== ПРЕДПОЧТЕНИЯ УВЕДОМЛЕНИЙ =====
model NotificationPreferences {
  userId          String  @id
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(false)
  pushEnabled     Boolean @default(true)
  telegramEnabled Boolean @default(false)
  inAppEnabled    Boolean @default(true)

  // Per-category opt-ins (all default true)
  orderUpdates   Boolean @default(true)
  paymentUpdates Boolean @default(true)
  promos         Boolean @default(true)
  messages       Boolean @default(true)
  reviews        Boolean @default(true)
  loyalty        Boolean @default(true)
  abandonedCart  Boolean @default(true)
  digest         Boolean @default(true)

  // Quiet hours (e.g. 22:00–09:00 — messages queued, not sent)
  quietHoursStart Int    @default(22)
  quietHoursEnd   Int    @default(9)
  timezone        String @default("Europe/Moscow")

  // Frequency caps
  maxPerDay Int @default(20)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ===== ЛОЯЛЬНОСТЬ: ТРАНЗАКЦИИ =====
model LoyaltyTransaction {
  id           String        @id @default(cuid())
  userId       String
  type         LoyaltyTxType
  points       Int // positive for EARN, negative for REDEEM/EXPIRE
  balanceAfter Int
  description  String
  orderId      String?
  amount       Int? // сумма заказа (в копейках)
  multiplier   Float?
  expiresAt    DateTime? // для бонусов с сроком действия
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("loyalty_transactions")
}

// ===== GAMIFICATION: Бейджи =====
// Бейдж — достижение, которое пользователь получает за определённое действие.
// Например: "Первый заказ", "5 заказов за месяц", "Отзыв на 5 звёзд".
model Badge {
  id           String   @id @default(cuid())
  code         String   @unique // "first_order", "five_orders_month", "review_5star"
  name         String // "Первый заказ"
  description  String // "Вы оформили свой первый заказ!"
  icon         String // emoji или имя lucide-иконки: "🎉", "🏆", "⭐"
  color        String   @default("#7c3aed") // hex color для бейджа
  category     String   @default("orders") // "orders" | "reviews" | "social" | "loyalty" | "special"
  // Условие получения (программно проверяется в сервисе)
  condition    Json? // { type: "orders_count", value: 1 } или { type: "reviews_count", value: 5 }
  // Награда за получение бейджа
  rewardPoints Int      @default(0) // бонусные баллы
  rewardType   String? // "points" | "discount" | "free_shipping"
  rewardValue  Int? // значение награды (для discount — %, для free_shipping — 1)
  // Сколько пользователей получили этот бейдж
  awardedCount Int      @default(0)
  // Редкость (для сортировки и отображения)
  rarity       String   @default("common") // "common" | "rare" | "epic" | "legendary"
  // Активен ли бейдж (можно ли его получить сейчас)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  userBadges UserBadge[]

  @@index([category])
  @@index([active])
  @@index([rarity])
  @@map("badges")
}

// Связь пользователя и бейджа (полученные бейджи)
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  // Когда получен
  awardedAt DateTime @default(now())
  // Контекст получения (например, orderId для "first_order")
  context   Json?

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

// ===== GAMIFICATION: Челленджи (задания) =====
// Челлендж — временное задание с наградой за выполнение.
// Например: "Закажи 3 торта в июле и получи 500 бонусов"
model Challenge {
  id                String   @id @default(cuid())
  code              String   @unique // "three_cakes_july"
  name              String // "Три торта в июле"
  description       String // "Закажите 3 торта в июле и получите 500 бонусов"
  icon              String // "🎂"
  color             String   @default("#7c3aed")
  // Тип цели
  goalType          String // "orders_count" | "orders_amount" | "reviews_count" | "referrals"
  goalValue         Int // 3 (заказа) или 5000 (рублей)
  // Награда
  rewardPoints      Int      @default(0)
  rewardType        String? // "points" | "discount" | "free_shipping" | "gift"
  rewardValue       Int?
  // Период действия
  startsAt          DateTime
  endsAt            DateTime
  // Активен ли
  active            Boolean  @default(true)
  // Сколько пользователей участвует / завершило
  participantsCount Int      @default(0)
  completedCount    Int      @default(0)
  createdAt         DateTime @default(now())

  userChallenges UserChallenge[]

  @@index([active])
  @@index([endsAt])
  @@map("challenges")
}

// Прогресс пользователя по челленджу
model UserChallenge {
  id              String    @id @default(cuid())
  userId          String
  challengeId     String
  // Текущий прогресс (0 до goalValue)
  progress        Int       @default(0)
  // Завершён ли челлендж
  completed       Boolean   @default(false)
  completedAt     DateTime?
  // Награда получена?
  rewardClaimed   Boolean   @default(false)
  rewardClaimedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([completed])
  @@map("user_challenges")
}

// ===== УВЕДОМЛЕНИЯ =====
model Notification {
  id           String               @id @default(cuid())
  userId       String
  template     NotificationTemplate
  channel      NotificationChannel  @default(in_app)
  status       NotificationStatus   @default(queued)
  title        String
  body         String
  data         Json?
  // metadata about delivery (e.g. message ID from SMS/email provider)
  externalId   String?
  errorMessage String?
  scheduledFor DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([template])
  @@index([scheduledFor])
  @@index([channel, status])
  @@map("notifications")
}

// ===== КОНДИТЕРЫ =====
model Confectioner {
  id                 String     @id @default(cuid())
  userId             String     @unique
  businessName       String
  slug               String     @unique
  description        String
  avatar             String
  cover              String?
  city               String
  location           Json
  rating             Float      @default(0)
  reviewsCount       Int        @default(0)
  ordersCount        Int        @default(0)
  verified           Boolean    @default(false)
  // Статус модерации: pending (ожидает админа), approved (verified=true),
  // rejected (отказ, причина в rejectionReason), needs_revision (запрос правок)
  verificationStatus String     @default("pending")
  verifiedBy         String? // userId админа
  verifiedAt         DateTime?
  rejectionReason    String?
  trustLevel         TrustLevel @default(NEW)
  tariff             Tariff     @default(START)
  legalInfo          Json
  taxMode            TaxMode    @default(NPD)
  specialization     String[]   @default([])
  portfolioImages    String[]   @default([])
  followersCount     Int        @default(0)
  responseTime       String     @default("")
  joinedAt           DateTime   @default(now())
  selfPickup         Boolean    @default(true)
  deliveryOptions    String[]   @default(["own"])
  paymentSettings    Json?
  ecoBadges          String[]   @default([])
  balance            Int        @default(0)
  totalEarnings      Int        @default(0)
  monthlyEarnings    Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products         Product[]
  orders           Order[]
  orgVerifications OrganizationVerification[]

  @@index([city])
  @@index([verified])
  @@index([verificationStatus])
  @@index([trustLevel])
  @@map("confectioners")
}

// ===== ТОВАРЫ =====
model Product {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String
  price          Int
  oldPrice       Int?
  category       String
  images         String[] @default([])
  confectionerId String
  rating         Float    @default(0)
  reviewsCount   Int      @default(0)
  weight         String?
  servings       Int?
  prepTime       String?
  isPopular      Boolean  @default(false)
  isNew          Boolean  @default(false)
  isHit          Boolean  @default(false)
  tags           String[] @default([])
  fillings       Json?
  coatings       Json?
  decorations    Json?
  paymentOptions Json?
  // AR / 3D preview
  modelUrl       String? // GLB/GLTF URL for 3D + AR preview
  modelUsdzUrl   String? // USDZ (iOS Quick Look)
  arEnabled      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  confectioner Confectioner  @relation(fields: [confectionerId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  cartItems    CartItem[]
  reviews      Review[]
  videoReviews VideoReview[]

  @@index([confectionerId])
  @@index([category])
  @@index([isPopular])
  @@index([isNew])
  @@index([isHit])
  @@map("products")
}

// ===== ЗАКАЗЫ =====
model Order {
  id                     String        @id @default(cuid())
  number                 String        @unique
  customerId             String
  confectionerId         String?
  courierId              String?
  items                  OrderItem[]
  total                  Int
  status                 OrderStatus   @default(PENDING)
  deliveryAddress        String?
  deliveryDate           DateTime
  deliveryTime           String?
  deliveryCost           Int           @default(0)
  paymentMethod          PaymentMethod @default(card)
  paymentStatus          PaymentStatus @default(pending)
  comment                String?
  escrowReleasedAt       DateTime?
  // P1: Снапшот тарифа и юр.статуса на момент создания заказа
  tariffSnapshot         String?
  commissionRateSnapshot Float?
  legalStatusSnapshot    String?
  // P1: Бонусный дисконт
  bonusPointsRedeemed    Int           @default(0)
  bonusDiscountRub       Int           @default(0)
  // P1: Промокод
  promoCodeApplied       String?
  promoCodeId            String?       @unique
  promoDiscount          Int?
  promoCode              PromoCode?    @relation("OrderPromoCode", fields: [promoCodeId], references: [id])
  // P1: Выплата
  payoutTransferredAt    DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  customer     User          @relation(fields: [customerId], references: [id])
  confectioner Confectioner? @relation(fields: [confectionerId], references: [id])

  @@index([customerId])
  @@index([confectionerId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  productId     String
  title         String
  image         String
  price         Int
  quantity      Int
  customization Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ===== КОРЗИНА =====
model CartItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  title         String
  image         String
  price         Int
  quantity      Int
  customization Json?
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@map("cart_items")
}

// ===== ОТЗЫВЫ =====
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  text      String
  images    String[] @default([])
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// ===== ВИДЕО-ОТЗЫВЫ =====
model VideoReview {
  id           String   @id @default(cuid())
  productId    String
  userId       String
  videoUrl     String
  thumbnailUrl String?
  rating       Int
  text         String?
  duration     Int
  views        Int      @default(0)
  likes        Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@map("video_reviews")
}

// ===== АКЦИИ =====
model Promotion {
  id              String    @id @default(cuid())
  confectionerId  String
  title           String
  description     String
  type            String
  value           Float?
  promoCode       String?
  minOrderAmount  Int?
  startDate       DateTime
  endDate         DateTime
  cities          String[]  @default([])
  status          String    @default("active")
  isPromoted      Boolean   @default(false)
  promotedUntil   DateTime?
  promotionBudget Int?
  image           String?
  views           Int       @default(0)
  clicks          Int       @default(0)
  conversions     Int       @default(0)
  usedCount       Int       @default(0)
  createdAt       DateTime  @default(now())

  confectioner User @relation(fields: [confectionerId], references: [id])

  @@index([confectionerId])
  @@index([status])
  @@map("promotions")
}

// ===== РЕЦЕПТЫ =====
model Recipe {
  id             String   @id @default(cuid())
  confectionerId String
  type           String   @default("recipe")
  title          String
  description    String
  coverImage     String
  prepTime       Int      @default(0)
  cookTime       Int      @default(0)
  difficulty     String   @default("easy")
  servings       Int      @default(1)
  ingredients    Json     @default("[]")
  steps          Json     @default("[]")
  tags           String[] @default([])
  category       String   @default("")
  access         String   @default("free")
  price          Int?
  views          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())

  confectioner User @relation(fields: [confectionerId], references: [id])

  @@index([confectionerId])
  @@map("recipes")
}

// ===== ЧАТ =====
model ChatRoom {
  id            String    @id @default(cuid())
  type          String    @default("direct")
  name          String
  avatar        String?
  participants  String[]  @default([])
  lastMessage   String?
  lastMessageAt DateTime?
  orderId       String?
  createdAt     DateTime  @default(now())

  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        String    @id @default(cuid())
  roomId    String
  senderId  String
  text      String
  isSystem  Boolean   @default(false)
  // Авточат: пометка bot-сообщений и их тип
  isBot     Boolean   @default(false)
  botKind   String? // "order_status" | "faq" | "quick_reply" | "escalation" | "welcome"
  // Rich content: кнопки quick replies, карточки с заказом и т.д.
  metadata  Json?
  // Прочитано ли сообщение
  readAt    DateTime?
  createdAt DateTime  @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id])

  @@index([roomId])
  @@index([senderId])
  @@index([isBot])
  @@map("chat_messages")
}

// ===== РЕФЕРАЛЬНАЯ ПРОГРАММА =====
model Referral {
  id               String   @id @default(cuid())
  userId           String   @unique
  referralCode     String   @unique
  totalInvited     Int      @default(0)
  activeReferrals  Int      @default(0)
  totalEarned      Int      @default(0)
  availableBalance Int      @default(0)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

// ===== ПОДАРОЧНЫЕ СЕРТИФИКАТЫ =====
model GiftCertificate {
  id              String    @id @default(cuid())
  code            String    @unique
  amount          Int
  fromUserId      String
  toName          String
  toEmail         String
  toPhone         String?
  message         String?
  design          String    @default("classic")
  status          String    @default("active")
  expiresAt       DateTime
  purchasedAt     DateTime  @default(now())
  usedAt          DateTime?
  remainingAmount Int?
  deliveryMethod  String    @default("email")
  toUserId        String?

  fromUser User  @relation("fromUser", fields: [fromUserId], references: [id])
  toUser   User? @relation("toUser", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@map("gift_certificates")
}

// ===== ПРАЗДНИКИ ПОЛЬЗОВАТЕЛЯ =====
model UserHoliday {
  id           String   @id @default(cuid())
  userId       String
  title        String
  type         String   @default("birthday")
  date         DateTime
  recurring    Boolean  @default(true)
  personName   String?
  relationship String?
  reminderDays Int      @default(14)
  notes        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_holidays")
}

