// ===== SimpleX Chat — приватный E2E-канал для премиум-клиентов =====
// Связывает внутренний userId маркетплейса с SimpleX-контактом.
// Используется для гибридной модели: Socket.IO (основной) + SimpleX (приватный).
model SimpleXContact {
  id               String   @id @default(cuid())
  userId           String // владелец SimpleX-профиля (обычно кондитер)
  // simplexConnectionId — локальный ID соединения в simplex-chat CLI
  simplexConnId    String?
  // simplexAddress — публичный адрес для подключения клиентов (smp://fp@host#key)
  simplexAddress   String?
  // displayName в SimpleX (имя, которое видят клиенты)
  simplexName      String?
  // тип профиля: "confectioner" | "support" | "b2b"
  profileType      String   @default("confectioner")
  // активен ли профиль (можно ли к нему подключаться)
  active           Boolean  @default(true)
  // сколько клиентов подключилось через этот адрес
  connectionsCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messages SimpleXMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileType])
  @@index([active])
  @@map("simplex_contacts")
}

// Сообщения, пришедшие через SimpleX (сохраняем для истории в дашборде)
// ВАЖНО: E2E означает, что simplex-bridge расшифровывает только те сообщения,
// которые приходят на его собственный профиль. Сообщения между двумя
// пользователями напрямую (без участия bridge) недоступны.
model SimpleXMessage {
  id               String   @id @default(cuid())
  // simplexContactId — профиль маркетплейса, который получил сообщение
  simplexContactId String
  // chatId из SimpleX (локальный в CLI)
  simplexChatId    String
  // simplexMsgId — ID сообщения в SimpleX
  simplexMsgId     String
  // от кого пришло (имя контакта в SimpleX — анонимный идентификатор)
  fromName         String?
  // содержимое сообщения (text/files расшифровываются bridge-сервисом)
  text             String?
  // метаданные (тип сообщения, вложения)
  metadata         Json?
  // направление: "incoming" (от клиента) | "outgoing" (от оператора)
  direction        String   @default("incoming")
  // прочитано ли оператором
  readByOperator   Boolean  @default(false)
  // связанный заказ (если сообщение относится к заказу)
  orderId          String?
  receivedAt       DateTime @default(now())

  simplexContact SimpleXContact @relation(fields: [simplexContactId], references: [id], onDelete: Cascade)

  @@index([simplexContactId])
  @@index([direction])
  @@index([receivedAt])
  @@index([orderId])
  @@map("simplex_messages")
}

// ===== AI-ДИАЛОГИ: САМООБУЧЕНИЕ =====
// Контекст отношений между конкретным покупателем и кондитером
// Создаётся/обновляется при каждом заказе и диалоге
model RelationshipContext {
  id                 String    @id @default(cuid())
  customerId         String // userId покупателя
  confectionerId     String // userId кондитера
  // Глубина отношений
  ordersCount        Int       @default(0) // сколько заказов между ними
  chatsCount         Int       @default(0) // сколько диалогов
  // Тип отношений: new (первый контакт) | repeat (повторный) | regular (постоянный) | vip
  relationshipType   String    @default("new")
  // Извлечённые предпочтения покупателя (для этого кондитера)
  preferences        Json? // { fillings: [], coatings: [], designs: [], budgetRange: {}, allergies: [] }
  // Паттерны общения
  communicationStyle Json? // { tone: "formal"|"friendly"|"casual", avgResponseTime, prefersShort: bool }
  // История ключевых фактов
  keyFacts           Json? // [{ fact: "Любит шоколад с малиной", date: "...", fromOrderId: "..." }]
  // Последний заказ
  lastOrderId        String?
  lastOrderDate      DateTime?
  // Уровень доверия (0-100) — растёт с каждым успешным заказом
  trustScore         Int       @default(0)
  // Метрики удовлетворённости
  avgRating          Float     @default(0)
  // Создание/обновление
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([customerId, confectionerId])
  @@index([customerId])
  @@index([confectionerId])
  @@index([relationshipType])
  @@map("relationship_contexts")
}

// Память диалога — извлечённые факты из переписки
model ConversationMemory {
  id              String    @id @default(cuid())
  customerId      String
  confectionerId  String
  chatRoomId      String?
  orderId         String?
  // Тип памяти: preference | allergy | budget | design | event | feedback | personal
  memoryType      String
  // Содержание (что извлек AI)
  content         String // "Любит тёмный шоколад без сахара"
  // Уверенность AI (0-1) — как сильно доверяет этой памяти
  confidence      Float     @default(0.5)
  // Источник: из какого сообщения извлечено
  sourceMessageId String?
  sourceText      String?
  // Подтверждено пользователем?
  confirmed       Boolean   @default(false)
  // Применимо только к этому кондитеру или глобально?
  isGlobal        Boolean   @default(false)
  // Срок годности (некоторые памяти устаревают — например, аллергии нет)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([customerId])
  @@index([confectionerId])
  @@index([customerId, confectionerId])
  @@index([memoryType])
  @@index([isGlobal])
  @@map("conversation_memories")
}

// Профиль обучения AI — агрегированный профиль пользователя
model AILearningProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  // Общие предпочтения (из всех диалогов)
  globalPreferences  Json? // { favoriteFillings: [], allergies: [], budgetRange: {}, designPreferences: [] }
  // Стиль общения
  communicationStyle Json? // { tone, avgMessageLength, prefersEmoji, responseTimeHours }
  // Поведенческие паттерны
  behaviorPatterns   Json? // { ordersOnWeekends: bool, prefersDelivery: bool, avgOrderValue: int }
  // Качество AI-подсказок (для самообучения)
  suggestionStats    Json? // { totalSuggestions: int, accepted: int, rejected: int, acceptanceRate: float }
  // Последнее обучение
  lastLearnedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@map("ai_learning_profiles")
}

// Лог обучения AI — каждая сессия извлечения фактов
model AILearningLog {
  id              String   @id @default(cuid())
  userId          String
  confectionerId  String?
  // Что было на входе (диалог/заказ/отзыв)
  sourceType      String // "chat" | "order" | "review" | "feedback"
  sourceId        String?
  // Что AI извлёк
  extractedFacts  Json? // [{ type, content, confidence }]
  // Сколько фактов добавлено в память
  memoriesCreated Int      @default(0)
  // Успешность (для метрики качества)
  userFeedback    String? // "helpful" | "not_helpful" | "ignored"
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([confectionerId])
  @@index([sourceType])
  @@map("ai_learning_logs")
}

// ===== CRM: ТИКЕТЫ ПОДДЕРЖКИ =====
// Тикеты от пользователей — обращения в поддержку по заказам, возвратам, вопросам.
model SupportTicket {
  id              String          @id @default(cuid())
  number          String          @unique // T-1024 (генерируется автоматически)
  customerId      String // ID пользователя (User.id)
  customerName    String // Денормилизованное имя для быстрого отображения
  customerEmail   String?
  subject         String // Тема обращения
  description     String // Подробное описание (Markdown)
  priority        TicketPriority  @default(medium)
  status          TicketStatus    @default(open)
  category        TicketCategory? // Тип обращения
  assignedTo      String? // ID админа/оператора (User.id)
  assignedName    String? // Имя исполнителя
  orderId         String? // Связь с заказом (опционально)
  orderNumber     String? // Номер заказа для быстрого отображения
  // SLA и время
  firstResponseAt DateTime? // Первый ответ оператора
  resolvedAt      DateTime? // Время закрытия
  // Оценка
  rating          Int? // 1-5 — оценка после закрытия
  ratingComment   String?
  // Метаданные
  tags            String[] // Теги для фильтрации
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  messages     TicketMessage[]
  interactions CustomerInteraction[]

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("support_tickets")
}

enum TicketPriority {
  low // Низкий
  medium // Средний
  high // Срочный
  urgent // Критический
}

enum TicketStatus {
  open // Открыт
  in_progress // В работе
  waiting // Ожидает ответа клиента
  resolved // Решён
  closed // Закрыт
  escalated // Эскалирован
}

enum TicketCategory {
  order_issue // Проблема с заказом
  payment // Оплата
  delivery // Доставка
  refund // Возврат
  product_quality // Качество товара
  confectioner // Кондитер
  account // Аккаунт
  technical // Техническая проблема
  other // Другое
}

// ===== CRM: СООБЩЕНИЯ ТИКЕТОВ =====
model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String // ID автора (User.id)
  authorName  String // Имя автора
  authorRole  String // "customer" | "admin" | "system"
  message     String // Текст сообщения (Markdown)
  isInternal  Boolean  @default(false) // Внутренний комментарий (не виден клиенту)
  attachments Json? // [{ name, url, size }]
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_messages")
}

// ===== CRM: ЛИДЫ (входящие потенциальные клиенты) =====
model Lead {
  id            String     @id @default(cuid())
  // Контакт
  name          String
  email         String?
  phone         String?
  company       String? // Для B2B
  // Источник
  source        LeadSource @default(website) // Откуда пришёл лид
  sourceDetails String? // UTM-метки, реферер и т.п.
  // Pipeline
  status        LeadStatus @default(new)
  stage         LeadStage  @default(awareness)
  // Что нужно
  need          String? // Описание потребности
  budget        Int? // Потенциальный бюджет (в рублях)
  // Ответственный
  assignedTo    String? // ID админа/менеджера
  assignedName  String?
  // Связь
  customerId    String? // Если лид конвертирован в клиента (User.id)
  orderId       String? // Если создан заказ
  // Метрики
  score         Int        @default(0) // Lead scoring (0-100)
  // Время
  contactedAt   DateTime? // Первый контакт
  convertedAt   DateTime? // Конвертация в клиента
  lostAt        DateTime? // Потерян
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  interactions CustomerInteraction[]

  @@index([status])
  @@index([stage])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("leads")
}

enum LeadSource {
  website // Форма на сайте
  phone // Звонок
  email // Email
  social_media // Соцсети
  referral // Реферал
  b2b_inquiry // B2B-запрос
  event // Мероприятие
  advertising // Реклама
  other
}

enum LeadStatus {
  new // Новый
  contacted // Контакт установлен
  qualified // Квалифицирован
  converted // Конвертирован в клиента
  lost // Потерян
  disqualified // Дисквалифицирован
}

enum LeadStage {
  awareness // Осведомлённость
  interest // Интерес
  consideration // Рассмотрение
  intent // Намерение
  evaluation // Оценка
  decision // Решение
}

// ===== CRM: ИСТОРИЯ ВЗАИМОДЕЙСТВИЙ С КЛИЕНТОМ =====
// Timeline всех контактов: заказы, тикеты, чаты, звонки, email.
model CustomerInteraction {
  id              String          @id @default(cuid())
  customerId      String // ID пользователя (User.id)
  customerName    String? // Имя для отображения
  // Тип взаимодействия
  type            InteractionType
  // Связь с сущностью (опционально)
  ticketId        String?
  leadId          String?
  orderId         String?
  // Содержание
  subject         String? // Краткое описание
  description     String? // Подробности
  metadata        Json? // Доп. данные (сумма заказа, длительность звонка и т.п.)
  // Результат
  outcome         String? // "positive" | "negative" | "neutral" | "pending"
  // Кто инициировал
  initiatedBy     String? // "customer" | "admin" | "system"
  initiatedByName String?
  // Время
  createdAt       DateTime        @default(now())

  ticket SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  lead   Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
  @@index([ticketId])
  @@index([leadId])
  @@map("customer_interactions")
}

enum InteractionType {
  order // Заказ
  ticket // Тикет поддержки
  chat // Чат
  call // Звонок
  email // Email
  review // Отзыв
  referral // Реферал
  payment // Платёж
  refund // Возврат
  dispute // Спор
  note // Заметка менеджера
  other
}

// ===== EMAIL: ПИСЬМА (отправленные и входящие) =====
// Хранит все email-сообщения — как отправленные платформой, так и входящие от пользователей.
// Используется для:
//  1. Журнала отправленных уведомлений (регистрация, заказы, тикеты)
//  2. Входящих писем (через webhook от Mailgun/SendGrid/IMAP)
//  3. Admin UI — таб «Почта» для просмотра переписки
model EmailMessage {
  id           String         @id @default(cuid())
  // Направление: исходящее (sent) или входящее (received)
  direction    EmailDirection
  // Отправитель / Получатель
  fromAddress  String // email отправителя
  fromName     String? // имя отправителя
  toAddress    String // email получателя
  toName       String? // имя получателя
  // Содержание
  subject      String
  textBody     String? // plain text версия
  htmlBody     String? // HTML версия
  // Связь с сущностями (опционально)
  userId       String? // связанный пользователь (для исходящих — получатель)
  orderId      String? // связанный заказ
  ticketId     String? // связанный тикет
  leadId       String? // связанный лид
  // Шаблон (если отправлено через шаблон)
  template     String? // "welcome", "order_created", "ticket_reply" и т.п.
  // Статус
  status       EmailStatus    @default(pending)
  errorMessage String? // ошибка отправки (если failed)
  // Метрики
  messageId    String? // RFC 822 Message-ID (для thread-tracking)
  inReplyTo    String? // Message-ID письма, на которое это отвечает
  // Внешний ID (от Mailgun/SendGrid)
  externalId   String? // ID во внешнем сервисе
  // Время
  sentAt       DateTime? // когда фактически отправлено
  receivedAt   DateTime? // когда получено (для входящих)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  attachments EmailAttachment[]

  @@index([direction])
  @@index([userId])
  @@index([orderId])
  @@index([ticketId])
  @@index([status])
  @@index([createdAt])
  @@index([toAddress])
  @@map("email_messages")
}

enum EmailDirection {
  sent // исходящее (от платформы)
  received // входящее (от пользователя)
}

enum EmailStatus {
  pending // в очереди отправки
  sent // отправлено успешно
  failed // ошибка отправки
  delivered // доставлено (подтверждение от Mailgun/SendGrid)
  bounced // возвращено (bounce)
  spam // помечено как спам
}

// ===== EMAIL: ВЛОЖЕНИЯ =====
model EmailAttachment {
  id        String   @id @default(cuid())
  emailId   String
  filename  String
  mimeType  String
  size      Int // в байтах
  url       String? // URL файла (S3/локально)
  content   Bytes? // бинарное содержимое (для небольших файлов)
  createdAt DateTime @default(now())

  email EmailMessage @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_attachments")
}

// ===== МОДЕРАЦИЯ КОНТЕНТА: ОЧЕРЕДЬ ПРОВЕРКИ =====
// Все пользовательские материалы (товары, отзывы, сообщения чата, рассылки)
// проходят автоматическую модерацию перед публикацией или помечаются для ручной проверки.
model ModerationQueue {
  id               String                 @id @default(cuid())
  // Тип контента
  contentType      ModerationContentType // product, review, chat_message, broadcast, venue, etc.
  contentId        String // ID связанной сущности
  // Автор контента
  authorId         String
  authorName       String?
  // Содержимое для модерации (snapshot)
  title            String?
  content          String // текст для проверки
  images           String[] // URL изображений для проверки
  // Результат автоматической проверки
  autoStatus       ModerationAutoStatus   @default(pending)
  autoReason       String? // причина (если отклонено/помечено)
  autoScore        Float                  @default(0) // 0-1, уровень риска
  // Категории нарушений (если найдены)
  violations       String[] // ["18+", "extremism", "drugs", "spam", "insult"]
  // Ручная модерация
  manualStatus     ModerationManualStatus @default(pending)
  moderatorId      String?
  moderatorName    String?
  moderatorComment String?
  // Связь с жалобами
  reports          ContentReport[]
  // Время
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  reviewedAt       DateTime?

  @@index([contentType])
  @@index([autoStatus])
  @@index([manualStatus])
  @@index([authorId])
  @@index([createdAt])
  @@map("moderation_queue")
}

enum ModerationContentType {
  product // Карточка товара
  product_review // Отзыв на товар
  confectioner_review // Отзыв на кондитера
  chat_message // Сообщение в чате
  broadcast // Рассылка от админа/кондитера
  venue // Площадка
  service_product // Услуга (печать, фейерверки)
  event // Событие (корпоратив)
  user_profile // Профиль пользователя (имя, аватар, описание)
  comment // Комментарий к блогу/рецепту
}

enum ModerationAutoStatus {
  pending // в очереди на проверку
  approved // автоматически одобрено
  flagged // помечено (нужна ручная проверка)
  rejected // автоматически отклонено
  error // ошибка при проверке
}

enum ModerationManualStatus {
  pending // ждёт ручной проверки
  approved // одобрено модератором
  rejected // отклонено модератором
  escalated // эскалировано (возврат админу)
  not_required // ручная проверка не требуется (авто-одобрено)
}

// ===== МОДЕРАЦИЯ КОНТЕНТА: ЖАЛОБЫ ПОЛЬЗОВАТЕЛЕЙ =====
model ContentReport {
  id               String       @id @default(cuid())
  // Что жалуются
  moderationId     String? // связь с ModerationQueue (если есть)
  contentType      String // тип контента (дублирует для независимости)
  contentId        String // ID контента
  // Кто жалуется
  reporterId       String
  reporterName     String?
  // Причина
  reason           ReportReason
  description      String? // пояснение от пользователя
  // Статус
  status           ReportStatus @default(new)
  moderatorId      String?
  moderatorComment String?
  // Время
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  resolvedAt       DateTime?

  moderation ModerationQueue? @relation(fields: [moderationId], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
  @@map("content_reports")
}

enum ReportReason {
  adult_content // Порнография / 18+
  violence // Насилие
  extremism // Экстремизм / призывы к противоправным действиям
  drugs // Наркотики
  weapons // Оружие
  spam // Спам
  scam // Мошенничество
  insult // Оскорбления
  hate_speech // Разжигание ненависти
  illegal_goods // Незаконные товары
  copyright // Нарушение авторских прав
  personal_data // Раскрытие персональных данных
  other // Другое
}

enum ReportStatus {
  new // Новая жалоба
  in_review // На рассмотрении
  resolved_action // Решено — действие принято (контент удалён)
  resolved_no_action // Решено — действие не требуется
  rejected // Отклонена (необоснованная)
}

// ===== МОДЕРАЦИЯ КОНТЕНТА: ПРАВИЛА (настраиваемые) =====
// Администратор может добавлять/редактировать правила модерации через UI.
model ModerationRule {
  id            String               @id @default(cuid())
  name          String // Название правила
  description   String?
  // Тип правила
  ruleType      ModerationRuleType
  // Параметры правила
  pattern       String // regex или список слов (через запятую)
  caseSensitive Boolean              @default(false)
  wholeWord     Boolean              @default(false)
  // Категория нарушения
  violation     String // "18+", "extremism", "drugs", "spam", "insult"
  // Действие при срабатывании
  action        ModerationRuleAction @default(flag)
  // Метаданные
  isActive      Boolean              @default(true)
  hitsCount     Int                  @default(0) // сколько раз сработало
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  createdBy     String?

  @@index([isActive])
  @@index([violation])
  @@map("moderation_rules")
}

enum ModerationRuleType {
  regex // Регулярное выражение
  keywords // Список ключевых слов
  url_pattern // Паттерн URL (для ссылок)
  email_pattern // Паттерн email (для контактов в описании)
}

enum ModerationRuleAction {
  reject // Автоматически отклонить
  flag // Пометить для ручной проверки
  warn // Предупредить автора (но опубликовать)
}
