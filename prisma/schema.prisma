// Истории (stories) кондитера
model ChannelStory {
  id             String   @id @default(cuid())
  confectionerId String
  // Медиа — изображение или видео
  image          String
  video          String? // URL видео (mp4) для видео-сторис
  type           String   @default("image") // "image" | "video"
  caption        String?
  // Длительность показа (сек) — для видео-сторис
  duration       Int      @default(5) // 5 секунд по умолчанию
  // Связь с товаром — если сторис рекламирует конкретный торт
  productId      String?
  // Связь с акцией
  promotionId    String?
  // Метрики
  viewsCount     Int      @default(0)
  likesCount     Int      @default(0)
  repliesCount   Int      @default(0)
  // Кто посмотрел (для подсчёта уникальных просмотров)
  viewedBy       String[] @default([])
  // TTL — история истекает через 24 часа после создания
  expiresAt      DateTime
  // Порядок в ленте (для закрепления)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([confectionerId])
  @@index([expiresAt])
  @@index([productId])
  @@index([type])
  @@map("channel_stories")
}

